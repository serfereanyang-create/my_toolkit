{
  "name": "aicode-cli-mvp",
  "version": "0.1.0",
  "description": "A local Claude-Code-like CLI coding agent MVP.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "aicode": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:node && npm run test:unit",
    "test:node": "npm run build && node --test dist/tests/*.test.js",
    "test:unit": "vitest run",
    "coverage": "npm run build && node --test --experimental-test-coverage dist/tests/*.test.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "smoke": "npm run build && node dist/src/index.js --provider mock --approval auto --session-dir .aicode-smoke/sessions --prompt \"smoke multi-tool task: inspect, write, read, and run command\"",
    "live-smoke": "npm run build && node dist/src/cli/liveSmokeMain.js",
    "audit:100": "npm run build && node dist/src/audit/checks.js",
    "ledger": "npm run build && node dist/src/audit/contextLedger.js --latest",
    "dev": "npm run build && node dist/src/index.js",
    "open": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-aicode.ps1"
  },
  "keywords": [
    "cli",
    "agent",
    "coding-assistant"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^3.6.0",
    "glob": "^10.3.10",
    "sharp": "^0.35.3",
    "typescript": "^5.8.2",
    "undici": "^7.30.1"
  }
}
