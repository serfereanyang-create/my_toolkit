{
  "name": "paper-assistant-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:run": "npm run build && electron .",
    "desktop:dir": "npm run build && electron-builder --dir",
    "desktop:build": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@vitejs/plugin-react": "latest",
    "antd": "^6.5.0",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "latest",
    "mathjs": "^14.8.0",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.178.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.178.1",
    "electron": "latest",
    "electron-builder": "latest",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.zcode.paperassistant",
    "productName": "科研论文辅助工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "PaperAssistant-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
