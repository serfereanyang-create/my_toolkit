# Default-ignore everything at repo root.
# We only track the subtrees relevant to the CC Desktop IDE work.
/*

# Whitelist directories we care about (and their contents via nested rules below).
# NOTE: cli/ is its own git repository — do NOT track it from the outer repo.
!/.gitignore
!/docs/
!/ide-desktop/
!/zcode-lite/

# Paper assistant desktop app (科研论文辅助工作台).
!/src/
!/electron/
!/scripts/
!/assets/
!/test-fixtures/
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/vitest.config.ts

# Local proxy runtime state — contains an apiKey field, never commit.
/scripts/api-proxy-state.json

# Inside whitelisted trees, ignore common build/vendor/output artifacts.
**/node_modules/
**/dist/
**/build/

# Local agent runtime state (sessions, task boards, persona) written into
# whichever folder is opened as a workspace — never source.
**/.aicode/

# Keep ZCode-lite source and package metadata visible to the outer repository.
!/zcode-lite/src/
!/zcode-lite/tests/
!/zcode-lite/package.json
!/zcode-lite/package-lock.json
!/zcode-lite/tsconfig.json
!/zcode-lite/README.md
!/zcode-lite/.gitignore
**/out/
**/.vite/
**/.turbo/
**/.next/
**/coverage/
**/.nyc_output/
**/*.tsbuildinfo
**/.DS_Store
**/Thumbs.db

# Local env / secrets
**/.env
**/.env.*
!**/.env.example

# Editor / OS
.vscode/
.idea/
*.swp
*.swo

# Logs
**/*.log
**/logs/

# Electron packaging artifacts
**/release/
**/*.asar

# Portable JDK downloaded for local builds
tools/

# Android freezer local SDK path
android-freezer/local.properties
android-freezer/.gradle/
android-freezer/app/build/
android-freezer/build/
ide-desktop/NUL
