{
  "name": "cc-desktop-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Claude-Code-style AI coding IDE desktop shell for the aicode CLI agent.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && vitest run --passWithNoTests && node --test tests/*.test.cjs",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "desktop:run": "npm run build && electron ."
  },
  "dependencies": {
    "lucide-react": "0.454.0",
    "monaco-editor": "0.52.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "electron": "32.2.5",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
