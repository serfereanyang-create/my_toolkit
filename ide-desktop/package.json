{
  "name": "cc-desktop-ide",
  "version": "0.1.0",
  "private": true,
  "description": "YOYcode — AI coding IDE desktop shell for the aicode CLI agent.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "icons": "node scripts/build-icons.cjs",
    "prebuild": "npm run icons",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && vitest run --passWithNoTests && node --test tests/*.test.cjs",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "desktop:run": "npm run build && electron ."
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "chokidar": "^3.6.0",
    "croner": "^9.1.0",
    "docx-preview": "0.4.0",
    "lucide-react": "0.454.0",
    "mime-types": "3.0.2",
    "monaco-editor": "^0.56.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "electron": "32.2.5",
    "sharp": "^0.35.3",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
