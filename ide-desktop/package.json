{
  "name": "cc-desktop-ide",
  "version": "0.1.0",
  "private": true,
  "description": "YOYcode — AI coding IDE desktop shell for the aicode CLI agent.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "icons": "node scripts/build-icons.cjs",
    "prebuild": "npm run icons",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && vitest run --passWithNoTests && node --test tests/*.test.cjs",
    "test:ui": "electron scripts/ui-smoke.cjs",
    "test:settings-ui": "electron scripts/settings-smoke.cjs",
    "test:workspace-ui": "electron scripts/workspace-smoke.cjs",
    "test:dialogs-ui": "electron scripts/dialog-smoke.cjs",
    "test:app-ui": "electron scripts/app-smoke.cjs",
    "test:app-write-ui": "electron scripts/app-smoke.cjs --writes",
    "test:app-sync-ui": "electron scripts/app-smoke.cjs --sync",
    "test:app-git-ui": "electron scripts/app-smoke.cjs --writes --sync",
    "test:app-background-ui": "electron scripts/app-smoke.cjs --background-only",
    "test:app-workflows": "electron scripts/app-smoke.cjs --writes --sync --background --cancel",
    "test:app-cancel-ui": "electron scripts/app-smoke.cjs --cancel-only",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "cli:build": "npm --prefix ../cli run build",
    "desktop:run": "npm run build && npm run cli:build && electron .",
    "test:bg-panel": "electron scripts/bg-panel-smoke.cjs",
    "test:gui-panel": "electron scripts/gui-panel-smoke.cjs",
    "test:memory-panel": "electron scripts/memory-panel-smoke.cjs",
    "test:git-init-panel": "electron scripts/git-init-panel-smoke.cjs",
    "test:gui-live": "node scripts/gui-panel-live.cjs",
    "test:bg-app": "node scripts/background-app-smoke.cjs",
    "test:bg-app-compatibility": "node scripts/background-app-compatibility.cjs",
    "test:bg-app-lifecycle": "node scripts/background-app-lifecycle.cjs",
    "test:bg-app-windows": "node scripts/background-app-windows.cjs",
    "test:bg-app-input": "node scripts/background-app-input.cjs",
    "test:host-cancel": "electron scripts/background-cancel-smoke.cjs",
    "test:bg-download": "electron scripts/bg-download-smoke.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "chokidar": "^3.6.0",
    "croner": "^9.1.0",
    "docx-preview": "0.4.0",
    "ignore": "^5.3.2",
    "lucide-react": "0.454.0",
    "mime-types": "3.0.2",
    "monaco-editor": "^0.56.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "electron": "32.2.5",
    "sharp": "^0.35.3",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
